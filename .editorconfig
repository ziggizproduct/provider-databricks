# Workspace standard, copied from ziggizproduct/arch. Do not edit in product
# repos; change it in arch and re-sync. Formatters own the details; this only
# keeps editors from fighting them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,rs}]
indent_size = 4

[{*.go,go.mod,go.sum,Makefile,*.mk}]
indent_style = tab
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
